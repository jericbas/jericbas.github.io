---
import Layout from '../layouts/Layout.astro';
import { Terminal, Sparkles, Cpu, Package, BookOpen, Clock } from 'lucide-react';
import GithubIcon from '../components/icons/GithubIcon';
---

<Layout
  title="Jeric Bas | Work in Progress 🚧"
  description="Personal developer space and living devlog by Jeric Bas. Currently under construction."
>
  <div class="py-10 sm:py-16 max-w-3xl mx-auto flex flex-col items-center text-center">
    <!-- Work in Progress Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 text-xs font-mono text-amber-500 mb-8 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
      <span class="font-semibold tracking-wide">🚧 WORK IN PROGRESS</span>
      <span class="text-amber-500/50">•</span>
      <span>Actively Crafting</span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-primary-theme leading-tight mb-6">
      Building a living devlog &amp; <span class="accent-text">systems portfolio</span>.
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg text-secondary-theme max-w-2xl leading-relaxed mb-10">
      Hi, I'm <strong>Jeric Bas</strong>. I build open-source tools, npm packages, and systems software in Rust &amp; TypeScript. This portfolio and live devlog is currently being shaped.
    </p>

    <!-- Theme Feature Highlight Box -->
    <div class="w-full p-6 sm:p-8 rounded-3xl border border-theme bg-surface seasonal-glow text-left mb-12 relative overflow-hidden">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-8 h-8 rounded-xl bg-surface-elevated border border-theme flex items-center justify-center">
          <Sparkles className="w-4 h-4 accent-text" />
        </div>
        <div>
          <h2 class="text-base font-bold text-primary-theme">
            Live Preview: Philippine Seasonal Theme Engine ✨
          </h2>
          <p class="text-xs text-muted-theme">
            Interactive theme system is live and fully functional.
          </p>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-secondary-theme leading-relaxed mb-4">
        Try switching appearances using the controls in the navbar above:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-surface-elevated border border-theme">
          <div class="font-semibold text-primary-theme mb-1">☀️ Light Mode</div>
          <div class="text-muted-theme text-[11px]">Crisp paper daylight interface for clear readability.</div>
        </div>

        <div class="p-3 rounded-xl bg-surface-elevated border border-theme">
          <div class="font-semibold text-primary-theme mb-1">🌒 Dim (Twilight)</div>
          <div class="text-muted-theme text-[11px]">Soft charcoal &amp; slate navy — easy on the eyes.</div>
        </div>

        <div class="p-3 rounded-xl bg-surface-elevated border border-theme">
          <div class="font-semibold text-primary-theme mb-1">🌑 Dark Mode</div>
          <div class="text-muted-theme text-[11px]">Pitch obsidian high-contrast night aesthetic.</div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-theme/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm">🌟</span>
          <span class="text-secondary-theme font-medium">
            <strong>Paskong Pinoy Palette:</strong>
          </span>
          <div class="inline-flex items-center gap-2 font-mono text-[11px] px-2.5 py-1 rounded-full bg-surface-elevated border border-theme">
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-600"></span> Festive Red</span>
            <span class="text-muted-theme">•</span>
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> Pine Green</span>
            <span class="text-muted-theme">•</span>
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Parol Yellow</span>
          </div>
        </div>
        <span class="text-muted-theme text-[11px]">
          All 12 seasons ready in dropdown ↗
        </span>
      </div>
    </div>

    <!-- What's Coming Section -->
    <div class="w-full text-left mb-10">
      <div class="text-xs font-mono uppercase tracking-wider text-muted-theme mb-4 flex items-center gap-1.5">
        <Clock className="w-3.5 h-3.5 accent-text" />
        What's in the works
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-2xl border border-theme bg-surface">
          <div class="w-7 h-7 rounded-lg bg-orange-500/10 text-orange-500 border border-orange-500/20 flex items-center justify-center mb-3">
            <Cpu className="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-primary-theme mb-1">Rust Systems</h3>
          <p class="text-xs text-muted-theme leading-relaxed">
            Fast, memory-safe CLI tools and Linux security monitors like oxitty and ufw-guard.
          </p>
        </div>

        <div class="p-4 rounded-2xl border border-theme bg-surface">
          <div class="w-7 h-7 rounded-lg bg-red-500/10 text-red-500 border border-red-500/20 flex items-center justify-center mb-3">
            <Package className="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-primary-theme mb-1">npm Tooling</h3>
          <p class="text-xs text-muted-theme leading-relaxed">
            Developer diagnostics and AST codemods like why-override and zod-v3-to-v4.
          </p>
        </div>

        <div class="p-4 rounded-2xl border border-theme bg-surface">
          <div class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-500 border border-blue-500/20 flex items-center justify-center mb-3">
            <BookOpen className="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-primary-theme mb-1">Living Devlog</h3>
          <p class="text-xs text-muted-theme leading-relaxed">
            Unfiltered engineering journal on architecture hurdles and milestones.
          </p>
        </div>
      </div>
    </div>

    <!-- Profile & Registry Links -->
    <div class="flex flex-wrap items-center justify-center gap-3 w-full">
      <a
        href="https://crates.io/users/jericbas"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-medium border border-orange-500/30 bg-orange-500/10 text-orange-600 dark:text-orange-400 hover:bg-orange-500/20 transition-colors shadow-xs"
      >
        <Cpu className="w-3.5 h-3.5" />
        <span>crates.io/~jericbas ↗</span>
      </a>

      <a
        href="https://www.npmjs.com/~jericbas?activeTab=packages"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-medium border border-red-500/30 bg-red-500/10 text-red-600 dark:text-red-400 hover:bg-red-500/20 transition-colors shadow-xs"
      >
        <Package className="w-3.5 h-3.5" />
        <span>npmjs.com/~jericbas ↗</span>
      </a>

      <a
        href="https://github.com/jericbas"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-medium border border-theme bg-surface hover:bg-surface-elevated text-primary-theme transition-colors shadow-xs"
      >
        <GithubIcon className="w-3.5 h-3.5" />
        <span>GitHub @jericbas ↗</span>
      </a>
    </div>
  </div>
</Layout>
