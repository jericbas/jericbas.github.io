---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Calendar, Clock, Tag } from 'lucide-react';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true && data.pubDate <= new Date() : true;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | Jeric Bas`}
  description={post.data.description}
>
  <article class="max-w-3xl mx-auto">
    <!-- Back link -->
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-xs text-secondary-theme hover:text-primary-theme transition-colors mb-6"
    >
      <ArrowLeft className="w-3.5 h-3.5" />
      Back to all posts
    </a>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-theme">
      {post.data.draft && (
        <div class="inline-block mb-3 px-3 py-1 rounded-full text-xs font-mono bg-amber-500/10 text-amber-500 border border-amber-500/20">
          ⚠️ Work in Progress (Draft)
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl font-extrabold text-primary-theme leading-tight tracking-tight mb-4">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-secondary-theme leading-relaxed mb-6">
        {post.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs text-muted-theme font-mono">
        <div class="flex items-center gap-1.5">
          <Calendar className="w-3.5 h-3.5" />
          <span>
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
        </div>

        <span>•</span>

        <div class="flex items-center gap-1.5">
          <span>By {post.data.author}</span>
        </div>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mt-4">
        {post.data.tags.map((tag: string) => (
          <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-surface-elevated text-secondary-theme">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Post Content -->
    <div class="prose prose-invert max-w-none text-secondary-theme space-y-6 leading-relaxed">
      <Content />
    </div>

    <script is:inline>
      (function () {
        function addCopyButtons() {
          document.querySelectorAll('pre').forEach(function (pre) {
            if (pre.getAttribute('data-language') === 'mermaid') return;
            if (pre.querySelector('.copy-btn')) return;
            var btn = document.createElement('button');
            btn.className = 'copy-btn';
            btn.type = 'button';
            btn.textContent = 'Copy';
            btn.style.cssText = 'position:absolute;top:0.5rem;right:0.5rem;font-size:0.7rem;padding:0.25rem 0.5rem;border-radius:0.375rem;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.05);color:inherit;cursor:pointer;opacity:0.7;transition:opacity 0.15s;';
            btn.addEventListener('mouseenter', function () { btn.style.opacity = '1'; });
            btn.addEventListener('mouseleave', function () { btn.style.opacity = '0.7'; });
            btn.addEventListener('click', function () {
              var code = pre.querySelector('code');
              var text = (code ? code.innerText : pre.innerText);
              navigator.clipboard.writeText(text).then(function () {
                btn.textContent = 'Copied!';
                setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
              }).catch(function () {
                btn.textContent = 'Failed';
                setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
              });
            });
            if (getComputedStyle(pre).position === 'static') {
              pre.style.position = 'relative';
            }
            pre.appendChild(btn);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', addCopyButtons);
        } else {
          addCopyButtons();
        }
      })();
    </script>

    <script>
      import mermaid from 'mermaid';

      let renderCount = 0;

      async function updateMermaidDiagrams() {
        // Find existing raw pres and convert them to container wrappers
        const rawPres = document.querySelectorAll('pre[data-language="mermaid"]');
        rawPres.forEach((pre, i) => {
          const codeEl = pre.querySelector('code');
          const code = (codeEl ? codeEl.innerText : pre.innerText).trim();
          if (!code) return;

          const container = document.createElement('div');
          container.className = 'mermaid-container my-8 p-4 rounded-xl bg-surface-elevated/40 border border-theme flex justify-center overflow-x-auto';
          container.dataset.mermaidSource = code;
          container.id = `mermaid-container-${i}`;
          pre.replaceWith(container);
        });

        const containers = document.querySelectorAll('.mermaid-container[data-mermaid-source]');
        if (!containers || containers.length === 0) return;

        const computed = getComputedStyle(document.documentElement);
        const currentMode = document.documentElement.getAttribute('data-mode') || 'dim';
        const isDark = currentMode !== 'light';

        const bgPage = computed.getPropertyValue('--bg-page').trim() || (isDark ? '#151b23' : '#f8fafc');
        const bgSurface = computed.getPropertyValue('--bg-surface').trim() || (isDark ? '#1f242c' : '#ffffff');
        const bgSurfaceElevated = computed.getPropertyValue('--bg-surface-elevated').trim() || (isDark ? '#282e38' : '#f1f5f9');
        const borderColor = computed.getPropertyValue('--border-color').trim() || (isDark ? '#333b47' : '#e2e8f0');
        const borderHover = computed.getPropertyValue('--border-hover').trim() || (isDark ? '#485263' : '#cbd5e1');
        const textPrimary = computed.getPropertyValue('--text-primary').trim() || (isDark ? '#f0f6fc' : '#0f172a');
        const textSecondary = computed.getPropertyValue('--text-secondary').trim() || (isDark ? '#9aa7b6' : '#475569');
        const textMuted = computed.getPropertyValue('--text-muted').trim() || (isDark ? '#6e7681' : '#94a3b8');
        const accentPrimary = computed.getPropertyValue('--accent-primary').trim() || '#dc2626';
        const accentSecondary = computed.getPropertyValue('--accent-secondary').trim() || '#16a34a';
        const accentGold = computed.getPropertyValue('--accent-gold').trim() || '#eab308';
        const accentBorder = computed.getPropertyValue('--accent-border').trim() || accentPrimary;

        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'loose',
          fontFamily: 'ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
          theme: 'base',
          themeVariables: {
            darkMode: isDark,
            background: bgSurfaceElevated,
            mainBkg: bgSurfaceElevated,
            primaryColor: bgSurfaceElevated,
            primaryTextColor: textPrimary,
            primaryBorderColor: accentPrimary,
            lineColor: accentGold || borderHover,
            arrowheadColor: accentGold || accentPrimary,
            edgeLabelBackground: bgSurface,
            textColor: textSecondary,
            secondaryColor: bgSurface,
            secondaryTextColor: textSecondary,
            secondaryBorderColor: borderColor,
            tertiaryColor: bgPage,
            tertiaryTextColor: textMuted,
            tertiaryBorderColor: borderColor,
            clusterBkg: bgSurface,
            clusterBorder: borderColor,
            titleColor: textPrimary,
            nodeBorder: accentPrimary,
            nodeTextColor: textPrimary,
          },
          themeCSS: `
            .node rect, .node circle, .node polygon, .node path {
              rx: 8px !important;
              ry: 8px !important;
              stroke-width: 1.5px !important;
            }
            .cluster rect {
              rx: 12px !important;
              ry: 12px !important;
              stroke-dasharray: 4 4 !important;
            }
            .edgeLabel {
              border-radius: 4px !important;
              padding: 2px 4px !important;
              font-size: 11px !important;
            }
          `,
        });

        for (let i = 0; i < containers.length; i++) {
          const container = containers[i] as HTMLElement;
          const source = container.dataset.mermaidSource;
          if (!source) continue;

          const renderId = `mermaid-svg-${i}-${renderCount++}`;
          try {
            const { svg } = await mermaid.render(renderId, source);
            container.innerHTML = svg;
          } catch (err) {
            console.error('Failed to render mermaid diagram:', err);
          }
        }
      }

      // Initial render
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateMermaidDiagrams);
      } else {
        updateMermaidDiagrams();
      }

      // Re-render when theme (data-mode) or season (data-season) changes
      let debounceTimer: ReturnType<typeof setTimeout> | null = null;
      const themeObserver = new MutationObserver((mutations) => {
        let shouldUpdate = false;
        for (const m of mutations) {
          if (m.attributeName === 'data-mode' || m.attributeName === 'data-season') {
            shouldUpdate = true;
            break;
          }
        }
        if (shouldUpdate) {
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            updateMermaidDiagrams();
          }, 60);
        }
      });

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-mode', 'data-season'],
      });
    </script>

    <!-- Article Footer -->
    <div class="mt-16 pt-8 border-t border-theme flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-theme">
      <div>
        Published by <strong>Jeric Bas</strong> on his living engineering journal.
      </div>
      <a
        href="https://github.com/jericbas"
        target="_blank"
        rel="noopener noreferrer"
        class="accent-text hover:underline"
      >
        Follow updates on GitHub →
      </a>
    </div>
  </article>
</Layout>
